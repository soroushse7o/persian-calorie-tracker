# ==============================================================================
# کالری‌شمار روزمره (KaloriShomar) — Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` for local overrides.
# For Vite apps deployed on Vercel or Railway, ALL client-exposed variables
# MUST start with the `VITE_` prefix and are embedded at build time.
# ==============================================================================

# Public application display title (Persian)
VITE_APP_NAME="کالری‌شمار روزمره"

# REQUIRED AT BUILD TIME (no default fallback — `npm run build` fails if unset!):
# Canonical public URL used for absolute og:image, og:url, canonical, and sitemap.xml.
# Example (Vercel): https://persian-calorie-tracker.vercel.app
# Example (Railway / Custom Domain): https://kalorishomar.ir
VITE_SITE_URL="https://persian-calorie-tracker.vercel.app"

# Default daily nutrition targets for brand-new users (before they customize in Settings)
VITE_DEFAULT_DAILY_KCAL=2000
VITE_DEFAULT_WATER_GOAL_GLASSES=8

# Enable offline PWA Service Worker registration in production builds ("true" | "false")
VITE_ENABLE_PWA=true

# Public repository URL used for GitHub Issues feedback & food correction templates
VITE_REPO_URL="https://github.com/soroushse7o/persian-calorie-tracker"
